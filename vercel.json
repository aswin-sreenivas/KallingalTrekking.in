{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/banasura-weather",
      "destination": "/api/banasura-weather"
    },
    {
      "source": "/api/google-reviews",
      "destination": "/api/google-reviews"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
